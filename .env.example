# ─── Runtime ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_URL=https://diroxcode.up.railway.app
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=https://diroxcode.up.railway.app

# ─── Supabase (database + auth) ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. Never expose to the browser. Used for admin + system writes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Direct Postgres connection, used only to apply migrations at boot. Set this
# and the server provisions and updates its own schema — no SQL to paste.
#   Supabase > Project Settings > Database > Connection string > Session pooler
# Use the SESSION pooler (port 5432) or the direct connection, not the
# transaction pooler (6543): that one cannot hold a transaction or a lock.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set false to manage the schema yourself.
MIGRATE_ON_BOOT=true

# ─── Encryption ─────────────────────────────────────────────────────────────
# 32-byte base64 key used to encrypt provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DIROX_ENCRYPTION_KEY=

# ─── AI providers (server-only, optional per provider) ──────────────────────
# Referenced by model_providers.key_ref in the database.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# ─── GitHub integration ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=https://diroxcode.up.railway.app/api/github/callback

# ─── Billing (Stripe-ready) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Execution sandbox ──────────────────────────────────────────────────────
WORKSPACE_ROOT=/tmp/diroxcode-workspaces
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MAX_OUTPUT=20000
